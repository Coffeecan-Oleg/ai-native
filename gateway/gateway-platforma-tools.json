            "type": "string",
            "enum": [
              "Обычный",
              "Высокий",
              "Критичный"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 2000
          },
          "period": {
            "type": "string",
            "description": "YYYY-MM from context.periods or all; default snapshot month"
          },
          "due_from": {
            "type": "string",
            "format": "date"
          },
          "due_to": {
            "type": "string",
            "format": "date"
          },
          "overdue_only": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "default": 0
          },
          "sort": {
            "type": "string",
            "enum": [
              "due_asc",
              "due_desc",
              "created_desc",
              "id"
            ]
          }
        },
