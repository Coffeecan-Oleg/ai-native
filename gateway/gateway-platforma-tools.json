      "backend": "platforma",
      "transport": "platforma-demo",
      "scope": "platforma:read",
      "http_method": "GET",
      "description": "Read fictional requests; filters and overdue status use the snapshot date.",
      "status": "implemented",
      "arguments_schema": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "service_id": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
