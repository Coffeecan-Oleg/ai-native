          },
          "query": {
            "type": "string",
            "maxLength": 2000
          },
          "period": {
            "type": "string",
            "description": "YYYY-MM from context.periods or all; default snapshot month"
          },
          "due_from": {
            "type": "string",
            "format": "date"
          },
          "due_to": {
            "type": "string",
            "format": "date"
          },
          "overdue_only": {
            "type": "boolean",
